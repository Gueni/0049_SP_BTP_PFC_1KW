                          Component {
                            Type          From
                            Name          "From Cj"
                            Show          off
                            Position      [220, 245]
                            Direction     left
                            Flipped       off
                            LabelPosition north
                            Parameter {
                              Variable      "Tag"
                              Value         "Cj"
                              Show          off
