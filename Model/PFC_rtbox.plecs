                    Component {
                      Type          CScript
                      Name          "FET core"
                      Show          on
                      Position      [750, 295]
                      Direction     up
                      Flipped       off
                      LabelPosition south
                      Parameter {
                        Variable      "DialogGeometry"
                        Value         ""
