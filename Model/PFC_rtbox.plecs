                      Parameter {
                        Variable      "Parameters"
                        Value         "[Switch.Ch.Vt0 Switch.Ch.aVt Switch.Ch."
"nphi0 Switch.Ch.K0 Switch.Ch.bK Switch.Ch.Rd0 Switch.Ch.bRd Switch.Ch.Iq0 Swi"
"tch.Ch.bIq Switch.Ch.theta Switch.Ch.lambda Switch.Ch.m], Switch.Cap.V, Switc"
"h.Cap.Coss, Switch.Cap.Crss, [Switch.Cap.Ciss Switch.Cap.Vciss Switch.Cap.Cgd"
"_ox Switch.Cap.kdyn Switch.Cap.Vacc], [Switch.Aval.Vbr Switch.Aval.Rav], Swit"
"ch.nPara"
                        Show          off
                      }
                      Parameter {
                        Variable      "LangStandard"
                        Value         "2"
                        Show          off
                      }
                      Parameter {
                        Variable      "GnuExtensions"
                        Value         "1"
                        Show          off
                      }
