                        Value         "[1 1 1 1]"
                        Show          off
                      }
                      Parameter {
                        Variable      "NumOutputs"
                        Value         "[1 2 2 2 1 1 1]"
                        Show          off
                      }
                      Parameter {
                        Variable      "NumContStates"
                        Value         "0"
                        Show          off
                      }
                      Parameter {
                        Variable      "NumDiscStates"
                        Value         "0"
                        Show          off
                      }
                      Parameter {
                        Variable      "NumZCSignals"
                        Value         "1"
                        Show          off
                      }
                      Parameter {
                        Variable      "DirectFeedthrough"
                        Value         "1"
