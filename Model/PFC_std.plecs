                        }
                        Parameter {
                          Variable      "Declarations"
                          Value         "#include <stdlib.h>\n"
"#include <math.h>\n"
"#include <string.h>\n"
"#include <limits.h>\n"
"#include <float.h>\n"
"\n"
"#define T_PERIOD ParamRealData(0, 0)\n"
"#define INIT(i)  ParamRealData(1, (i)%ParamDim(1,1))\n"
"#define WIDTH    NumInputSignals(0)\n"
"\n"
"static double *buffer = NULL;\n"
"static double *prevContState = NULL;\n"
"static double *delayedContState = NULL;\n"
"\n"
"static int buf_width;\n"
"static int buf_size;\n"
"static int head;\n"
"static int tail;\n"
"\n"
"/* Mark the first call to the Output Function at the current time step: */\n"
"static double lastMajorOutputCall;"
                          Show          off
                        }
                        Parameter {
                          Variable      "StartFcn"
                          Value         "if (NumParameters != 2)\n"
"{\n"
"   SetErrorMessage(\"Number of parameters does not match.\");\n"
"   return;\n"
"}\n"
"if (ParamNumDims(0) != 2 || ParamDim(0, 0) != 1 || ParamDim(0, 1) != 1\n"
"    || T_PERIOD <= 0.)\n"
"{\n"
"   SetErrorMessage(\"Error in parameter 'Average time': positive scalar numbe"
"r expected.\");\n"
"   return;\n"
"}\n"
"if (ParamNumDims(1) != 2 || ParamDim(1,0) != 1)\n"
"{\n"
"\tSetErrorMessage(\"Error in parameter 'Initial Condition': Scalar value or v"
"ector expected.\")\n"
"\treturn;\n"
"}\n"
"if (ParamDim(1,1) != 1 && ParamDim(1,1) != WIDTH)\n"
"{\n"
"\tSetErrorMessage(\"Error in parameter 'Initial Condition': The number of ini"
"tial conditions must be 1 or match the number of input signals.\");\n"
"\treturn;\n"
"}\t\n"
"\n"
"buf_width = 1 + WIDTH; /* including time stamp */\n"
"buf_size = buf_width * 1024;\n"
"\n"
"buffer = (double*) malloc(buf_size * sizeof(double));\n"
"prevContState = (double*) malloc(WIDTH * sizeof(double));\n"
"delayedContState = (double*) malloc(WIDTH * sizeof(double));\n"
"if (!buffer || !prevContState || !delayedContState)\n"
"{\n"
"   SetErrorMessage(\"Out of memory while allocating buffer.\");\n"
"   /* possible allocated buffer is released in terminate function */\n"
"   return;\n"
"}\n"
"\n"
"tail = 0; \n"
"head = buf_width;\n"
"\n"
"/* Initialize the first element with zero */\n"
"buffer[0] = CurrentTime - T_PERIOD;\n"
"double *x0 = &buffer[1];\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"   x0[i] = 0.0;\n"
"\n"
"lastMajorOutputCall = -DBL_MAX;\n"
"\n"
"/* Set initial condition */\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"   ContState(i) = INIT(i);"
                          Show          off
                        }
                        Parameter {
                          Variable      "OutputFcn"
                          Value         "/* find interval to interpolate the pas"
"t values */\n"
"int left = tail;\n"
"int right = tail;\n"
"double t = CurrentTime - T_PERIOD;\n"
"while (t > buffer[right])\n"
"{\n"
"   int new_right = (right + buf_width) % buf_size;\n"
"\n"
"   if (new_right == head)\n"
"      break;\n"
"   \n"
"   left = right;\n"
"   right = new_right;\n"
"}\n"
"\n"
"/* linear interpolation */\n"
"const double dt = buffer[right] - buffer[left];\n"
"const double k  = dt == 0.0 ? 0.0 : (buffer[right] - t) / dt;\n"
"const double *x_left = &buffer[1 + left];\n"
"const double *x_right = &buffer[1 + right];\n"
"\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"   delayedContState[i] = (x_left[i] - x_right[i]) * k + x_right[i];\n"
"\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"{\n"
"   if (IsSampleHit(1) && lastMajorOutputCall != CurrentTime) /* fixed sample "
"time */\n"
"   {\n"
"      prevContState[i] = ContState(i);\n"
"      OutputSignal(0, i) = ContState(i);\n"
"      ContState(i) = 0.0;\n"
"   }\n"
"   else if (CurrentTime > (lastMajorOutputCall + fabs(lastMajorOutputCall)*DB"
"L_EPSILON))\n"
"   {\n"
"      OutputSignal(0, i) = ContState(i) + DiscState(i) - delayedContState[i];"
"\n"
"      prevContState[i] = ContState(i);\n"
"   }\n"
"}\n"
"   \n"
"if (IsMajorStep)\n"
"{\n"
"\ttail = left;\n"
"   lastMajorOutputCall = CurrentTime;\n"
"}"
                          Show          off
                        }
                        Parameter {
                          Variable      "UpdateFcn"
                          Value         "for (int j = IsSampleHit(1) ? 2 : 1; j "
"> 0; --j) /* execute 2x for fixed sample hits */\n"
"{\n"
"   if (head == tail) /* ring buffer too small */\n"
"   {\n"
"      const int new_buf_size = 2 * buf_size;\n"
"      double *new_buffer = (double*) malloc(new_buf_size * sizeof(double));\n"
"      if (!new_buffer)\n"
"      {\n"
"         SetErrorMessage(\"Out of memory while allocating buffer.\");\n"
"         return;\n"
"      }\n"
"      memcpy(new_buffer, buffer + tail, (buf_size - tail) * sizeof(double));"
"\n"
"      memcpy(new_buffer + buf_size - tail, buffer, tail * sizeof(double));\n"
"      free(buffer);\n"
"      head     = buf_size;\n"
"      tail     = 0;\n"
"      buffer   = new_buffer;\n"
"      buf_size = new_buf_size;\n"
"   }\n"
"\n"
"   buffer[head] = CurrentTime;\n"
"   double *x = &buffer[1 + head];\n"
"   for (int i = 0; i < WIDTH; ++i)\n"
"      x[i] = prevContState[i];\n"
"   head = (head + buf_width) % buf_size;\n"
" \n"
"   if (j == 2) /* IsSampleHit(1) first round */\n"
"   {\n"
"      for (int i = 0; i < WIDTH; ++i)\n"
"      {\n"
"         DiscState(i) = prevContState[i];\n"
"         prevContState[i] = ContState(i);\n"
"      }\n"
"   }\n"
"}"
                          Show          off
                        }
                        Parameter {
                          Variable      "DerivativeFcn"
                          Value         "for (int i = 0; i < WIDTH; ++i)\n"
"   ContDeriv(i) = InputSignal(0, i)/T_PERIOD;"
                          Show          off
                        }
                        Parameter {
                          Variable      "TerminateFcn"
                          Value         "free(buffer);\n"
"free(prevContState);\n"
"free(delayedContState);"
                          Show          off
                        }
                        Parameter {
                          Variable      "StoreCustomStateFcn"
                          Value         "const int N = ((head - tail) % buf_size"
" + buf_size) % buf_size;\n"
"WriteCustomStateInt(WIDTH);\n"
"WriteCustomStateInt(N);\n"
"WriteCustomStateDouble(lastMajorOutputCall);\n"
"\n"
"for (int i = 0; i < N; ++i)\n"
"   WriteCustomStateDouble(buffer[(tail + i) % buf_size]);\n"
"\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"{\n"
"   WriteCustomStateDouble(prevContState[i]);\n"
"   WriteCustomStateDouble(delayedContState[i]);\n"
"}"
                          Show          off
                        }
                        Parameter {
                          Variable      "RestoreCustomStateFcn"
                          Value         "if (ReadCustomStateInt() != WIDTH)\n"
"{\n"
"\tSetErrorMessage(\"The number of input signals has changed. The custom state"
" can not be restored.\");\n"
"\treturn;\n"
"}\n"
"const int N = ReadCustomStateInt();\n"
"tail = 0;\n"
"head = N;\n"
"lastMajorOutputCall = ReadCustomStateDouble();\n"
"\n"
"if (N > buf_size)\n"
"{\n"
"   while (N > buf_size)\n"
"      buf_size *= 2;\n"
"   \n"
"   double *new_buffer = (double*) realloc(buffer, buf_size*sizeof(double));\n"
"   if (!new_buffer)\n"
"   {\n"
"\t   SetErrorMessage(\"Out of memory while allocating buffer.\");\n"
"\t   return;\n"
"   }\n"
"   buffer = new_buffer;\n"
"}\n"
"\n"
"for (int i = 0; i < N; ++i)\n"
"   buffer[i] = ReadCustomStateDouble();\n"
"\t\n"
"for (int i = 0; i < WIDTH; ++i)\n"
"{\n"
"   prevContState[i] = ReadCustomStateDouble();\n"
"   delayedContState[i] = ReadCustomStateDouble();\n"
"}"
                          Show          off
                        }
                      }
                      Connection {
                        Type          Signal
                        SrcComponent  "C-Script"
                        SrcTerminal   2
                        DstComponent  "Out1"
                        DstTerminal   1
                      }
                      Connection {
