                Component {
                  Type          ThermalChain
                  Name          "Zth_jc"
                  Show          on
                  Position      [1675, 645]
                  Direction     up
                  Flipped       off
                  LabelPosition south
                  Parameter {
                    Variable      "Rth"
                    Value         "Switch.Th.Rth/Switch.nPara"
                    Show          off
                  }
