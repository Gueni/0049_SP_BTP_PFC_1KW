              Component {
                Type          Subsystem
                Name          "Turn-on Delay12"
                Show          off
                Position      [1545, 275]
                Direction     up
                Flipped       off
                LabelPosition south
                Frame         [-15, -15; 15, 15]
                SampleTime    "-1"
                CodeGenDiscretizationMethod "2"
                CodeGenTarget "Generic"
                MaskType      "Turn-on Delay"
                MaskDescription "This block is used to delay the turn-on command"
" for power semiconductors:\n"
"* When the input signal changes from 0 to 1 the output signal will follow aft"
"er the dead time has passed, provided that the input signal has remained 1.\n"
"* When the input signal becomes 0, the output is immediately set to 0."
                MaskHelp      "qthelp:///turnondelay.html"
                MaskDisplay   "Icon:color('text')\n"
"Icon:line({-7, -1}, {0, 0})\n"
"Icon:line({-3.5, -1.5, -3.5}, {-1, 0, 1})\n"
"\n"
"if Dialog:get('DeadTimeSource') ~= '1' then\n"
" Icon:text(-11, 5, 'T', 'FontSize', 8)\n"
"end\n"
"\n"
"Icon:color('signal')\n"
"Icon:line({-11, -7, -7, 7, 7, 11}, {7, 7, -7, -7 ,7, 7})\n"
"Icon:line({-7, -1, -1}, {7, 7, -7})\n"
                MaskDisplayLang "2"
                MaskIconFrame on
                MaskIconOpaque on
                MaskIconRotates off
                MaskInit      "if isnan(Rounding),\n"
"  Rounding = 1;\n"
"end"
                MaskDialogCallback "local choice = Dialog:get('DeadTimeSource')"
"\n"
"Dialog:set('T_d', 'Visible', choice ~= '2')\n"
"Dialog:set('Rounding', 'Visible', choice ~= '1')\n"
"if choice == '1' then\n"
"  Block:showTerminal('T', false)\n"
"  Block:moveTerminal('u', -15, 0)\n"
"else\n"
"  Block:showTerminal('T', true)\n"
"  Block:moveTerminal('u', -15, -5)\n"
"end\n"
                Parameter {
                  Variable      "DeadTimeSource"
                  Prompt        "Dead time source"
                  Type          FixedText
                  PossibleValues {"internal", "external"}
                  Value         "2"
                  Show          off
                  Tunable       off
                  TabName       ""
                }
                Parameter {
                  Variable      "T_d"
