                Schematic {
                  Component {
                    Type          Input
                    Name          "In1"
                    Show          off
                    Position      [40, 80]
                    Direction     right
                    Flipped       off
                    LabelPosition south
                    Parameter {
                      Variable      "Index"
                      Value         "1"
                      Show          on
                    }
