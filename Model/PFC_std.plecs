                Component {
                  Type          CScript
                  Name          "FET core"
                  Show          on
                  Position      [750, 295]
                  Direction     up
                  Flipped       off
                  LabelPosition south
                  Parameter {
                    Variable      "DialogGeometry"
                    Value         ""
                    Show          off
                  }
                  Parameter {
                    Variable      "NumInputs"
                    Value         "[1 1 1 1]"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumOutputs"
                    Value         "[1 2 2 2 1 1 1]"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumContStates"
                    Value         "0"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumDiscStates"
                    Value         "0"
