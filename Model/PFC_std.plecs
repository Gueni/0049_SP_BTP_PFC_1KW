                              CodeFcn       "local dataType = Block.OutputType[1][1]\n"
"local fmt = (dataType == \"float\") and \"%.9ef\" or \"%.18e\"\n"
"local bufferWidth = Block.NumOutputSignals[1]\n"
"local bufferLength = math.ceil(Block.Mask.T_period/Block.SampleTime[1])\n"
"local correction = bufferLength - Block.Mask.T_period/Block.SampleTime[1]\n"
"local buffer = Block:AddWorkVariable(dataType, bufferWidth*bufferLength)\n"
"local bufferIdx = Block:AddWorkVariable(\"size_t\")\n"
"local initValue = Block.Mask.x0\n"
"\n"
"if Block.SampleTime[1] > Block.Mask.T_period then\n"
"\treturn 'Error in parameter \"Averaging time\": The averaging time must be h"
"igher than the discretization step size of the model.'\n"
"end\n"
"\n"
"if #initValue ~= bufferWidth then\n"
"\tif #initValue ~= 1 then\n"
"\t\treturn 'Error in parameter \"Initial Condition\": The number of initial c"
"onditions must be 1 or match the number of input signals.'\n"
"\tend\n"
"end\n"
"\n"
"local outputSignal = Block:OutputSignal()\n"
"\n"
"local initCode = StringList:new()\n"
"\n"
"initCode:append([=[ \n"
"\t{\n"
"\t%(type)s *buffer = &%(buffer1)s;\n"
"\tsize_t i;\n"
"\tfor (i = 0; i < %(length)i; ++i)\n"
"\t\t{\n"
"\t]=]\n"
"\t%\n"
"\t{\n"
"\tlength = bufferLength,\n"
"\ttype = dataType,\n"
"  \tbuffer1 = buffer[1],\n"
"  \t})\n"
"\n"
"if #initValue == 1 then\n"
"\tfor idx = 1, #Block.InputSignal[1] do\n"
"\t\tinitCode:append([=[\n"
"\t\tbuffer[%(bufferWidth)i*i + %(inputIdx)i] = %(initValue)s;\n"
"\t\t]=]\n"
"\t\t%\n"
"\t\t{\n"
"\t\tinputIdx = idx-1,\n"
"  \t\tbufferWidth = bufferWidth,\n"
"  \t\tinitValue = fmt % {initValue},\n"
"  \t\t})\n"
"\tend\n"
"elseif #initValue == bufferWidth then\n"
"\tfor idx = 1, #Block.InputSignal[1] do\n"
"\t\tinitCode:append([=[\n"
"\t\tbuffer[%(bufferWidth)i*i + %(inputIdx)i] = %(initValue)s;\n"
"\t\t]=]\n"
"\t\t%\n"
"\t\t{\n"
"\t\tinputIdx = idx-1,\n"
"\t\tbufferWidth = bufferWidth,\n"
"  \t\tinitValue = fmt % {initValue[idx]},\n"
"  \t\t})\n"
"\tend\n"
"end\n"
"-- final closing braces\n"
"initCode:append(\"}}\")\n"
"\n"
"local outputCode = StringList:new()\n"
"\n"
"-- initial opening brace\n"
"outputCode:append(\"{\")\n"
"\n"
"-- variable declarations and initializations\n"
"if correction ~= 0 then\n"
"  outputCode:append(\"size_t bufferIdx = %s;\" % { bufferIdx})\n"
"end\n"
"outputCode:append([=[\n"
"size_t i, j;\n"
"%(type)s *buffer = &%(buffer1)s;\n"
"%(type)s *result = &%(result1)s;\n"
"memset(result, 0, %(width)i * sizeof(%(type)s));\n"
"]=]\n"
"%\n"
"{\n"
"  type = dataType,\n"
"  width = bufferWidth,\n"
"  length = bufferLength,\n"
"  result1 = outputSignal[1][1],\n"
"  buffer1 = buffer[1],\n"
"})\n"
"\n"
"-- accumulate\n"
"outputCode:append([=[\n"
"for (i = 0; i < %(length)i; ++i)\n"
"{\n"
"  for (j = 0; j < %(width)i; ++j)\n"
"  {\n"
"     result[j] += buffer[%(width)i*i+j];\n"
"  }\n"
"}\n"
"]=]\n"
"%\n"
"{\n"
"  width = bufferWidth,\n"
"  length = bufferLength,\n"
"})\n"
"\n"
"-- correct (if necessary) and scale\n"
"local factor = Block.SampleTime[1]/Block.Mask.T_period\n"
"outputCode:append(\"for (j = 0; j < %i; ++j) {\" % { bufferWidth })\n"
"if correction ~= 0 then\n"
"  outputCode:append(\"result[j] -= buffer[%i*bufferIdx+j] * %s;\" % { bufferW"
"idth, fmt % correction })\n"
"end\n"
"outputCode:append(\"result[j] *= %s;\" % { fmt % factor })\n"
"outputCode:append(\"}\")\n"
"\n"
"-- final closing brace\n"
"outputCode:append(\"}\")\n"
"\n"
"\n"
"return {\n"
"   OutputCode = outputCode,\n"
"   InitCode = initCode,\n"
"   UserData = { \n"
"      result1 = outputSignal[1][1],\n"
"      buffer1 = buffer[1],\n"
"      bufferIdx = bufferIdx,\n"
"   }\n"
"}\n"
                              NonDftCodeFcn "local dataType = Block.OutputType[1][1]\n"
"local bufferWidth = Block.NumOutputSignals[1]\n"
"local bufferLength = math.ceil(Block.Mask.T_period/Block.SampleTime[1])\n"
"\n"
"local code = StringList:new()\n"
"\n"
"-- initial opening brace\n"
"code:append(\"{\")\n"
"\n"
"-- variable declarations and initializations\n"
"code:append([=[\n"
"%(type)s *buffer = &%(buffer1)s;\n"
"%(type)s *result = &%(result1)s;\n"
"size_t bufferIdx = %(bufferIdx)s;\n"
"]=]\n"
"%\n"
"{\n"
"  type = dataType,\n"
"  result1 = Block.UserData.result1,\n"
"  buffer1 = Block.UserData.buffer1,\n"
"  bufferIdx = Block.UserData.bufferIdx,\n"
"})\n"
"\n"
"-- buffer input signals\n"
"for idx = 1, #Block.InputSignal[1] do\n"
"  code:append([=[\n"
"    buffer[%(bufferWidth)i*bufferIdx + %(inputIdx)i] = %(inputCode)s;\n"
"  ]=]\n"
"  %\n"
"  {\n"
"    bufferWidth = bufferWidth,\n"
"    inputIdx = idx-1,\n"
"    inputCode = Block.InputSignal[1][idx]\n"
"  })\n"
"end\n"
"\n"
"-- increment buffer index\n"
"code:append([=[\n"
"%(bufferIdx)s = (bufferIdx+1) %% %(length)i;\n"
"]=]\n"
"%\n"
"{\n"
"  bufferIdx = Block.UserData.bufferIdx,\n"
"  length = bufferLength,\n"
"})\n"
"\n"
"-- final closing brace\n"
"code:append(\"}\")\n"
"\n"
"return {\n"
"  UpdateCode = code,\n"
"}\n"
