              }
              TerminalNames { "In1", "Out1" }
              Location      [1037, 423; 1491, 657]
              ZoomFactor    1
              SliderPosition [0, 0]
              ShowBrowser   off
              BrowserWidth  100
              Configurations {
                Name          "continuous"
                Schematic {
                  Component {
                    Type          Input
