                                  }
                                  Parameter {
                                    Variable      "Ts"
                                    Value         "[0, 0; T_period, 0]"
                                    Show          off
                                  }
                                  Parameter {
                                    Variable      "TerminalBasedSampleTimes"
                                    Value         "1"
                                    Show          off
                                  }
                                  Parameter {
                                    Variable      "Parameters"
                                    Value         "T_period, x0"
                                    Show          off
                                  }
                                  Parameter {
                                    Variable      "LangStandard"
                                    Value         "2"
