                        Schematic {
                          Location      [1165, 45; 2559, 1283]
                          ZoomFactor    1
                          SliderPosition [0, 0]
                          ShowBrowser   off
                          BrowserWidth  100
                          Component {
                            Type          Input
                            Name          "In1"
                            Show          on
                            Position      [120, 80]
                            Direction     right
                            Flipped       off
                            LabelPosition south
                            Parameter {
                              Variable      "Index"
