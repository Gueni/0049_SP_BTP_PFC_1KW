              Component {
                Type          Subsystem
                Name          "Moving Average2"
                Show          off
                Position      [235, 160]
                Direction     up
                Flipped       off
                LabelPosition south
                Frame         [-15, -15; 15, 15]
                SampleTime    "-1"
                CodeGenDiscretizationMethod "2"
                CodeGenTarget "Generic"
                MaskType      "Moving Average"
                MaskDescription "Continuously averages the input signal over the"
" specified averaging time. The implementation of the Moving Average is less e"
"fficient than the Periodic Average.\n"
"\n"
"The initial condition describes the input signal before simulation start. "
                MaskHelp      "qthelp:///movingaverage.html"
                MaskDisplay   "Icon:color('axis')\n"
"Icon:line({-13, 13}, {11, 11})\n"
"Icon:line({-11, -11}, {-13,13})\n"
"Icon:color('text')\n"
"Icon:line({6, 10}, {4, 4})\n"
"Icon:line({10, 12, 10}, {5, 4, 3})\n"
"Icon:color('signal')\n"
"Icon:line({-11, -7, -7, 6, 6, 11}, {11, 11, -3, -3, 11, 11})"
                MaskDisplayLang "2"
                MaskIconFrame on
                MaskIconOpaque on
                MaskIconRotates off
                MaskInit      "if sum(isinf(x0)) > 0\n"
"\tplecs('error', 'The initial condition must be finite.'); return;\n"
"end\n"
"if not(isnumeric(x0))\n"
"\tplecs('error', 'Error in parameter \"Initial Condition\": Finite numerical "
"value expected.'); return;\n"
"end\n"
"if T_period <= 0.0\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": positive number expe"
"cted.'); return;\n"
"end\n"
"if not(isnumeric(T_period))\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": positive number expe"
"cted.'); return;\n"
"end\n"
"if length(T_period) > 1\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": scalar value expecte"
"d.'); return;\n"
"end\n"
                MaskDialogCallback "Dialog:set('buffer_size', 'Visible', false)"
                Parameter {
                  Variable      "x0"
                  Prompt        "Initial Condition"
                  Type          FreeText
                  Value         "1"
                  Show          off
                  Tunable       off
                  TabName       ""
                }
                Parameter {
                  Variable      "T_period"
                  Prompt        "Averaging time (s)"
                  Type          FreeText
                  Value         "1/Grid.f"
                  Show          off
                  Tunable       off
                  TabName       ""
                }
                Parameter {
                  Variable      "buffer_size"
                  Prompt        "Initial buffer size"
                  Type          FreeText
                  Value         "1024"
                  Show          off
                  Tunable       off
