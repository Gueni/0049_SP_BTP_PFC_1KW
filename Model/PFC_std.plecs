                      Component {
                        Type          CScript
                        Name          "C-Script"
                        Show          on
                        Position      [220, 80]
                        Direction     up
                        Flipped       off
                        LabelPosition south
                        Parameter {
                          Variable      "DialogGeometry"
                          Value         ""
                          Show          off
