                    Value         "[1 1 1 1]"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumOutputs"
                    Value         "[1 2 2 2 1 1 1]"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumContStates"
                    Value         "0"
