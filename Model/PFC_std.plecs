                          MaskInit      "if sum(isinf(x0)) > 0\n"
"\tplecs('error', 'The initial condition must be finite.'); return;\n"
"end\n"
"if not(isnumeric(x0))\n"
"\tplecs('error', 'Error in parameter \"Initial Condition\": Finite numerical "
"value expected.'); return;\n"
"end\n"
"if T_period <= 0.0\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": positive number expe"
"cted.'); return;\n"
"end\n"
"if not(isnumeric(T_period))\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": positive number expe"
"cted.'); return;\n"
"end\n"
"if length(T_period) > 1\n"
"\tplecs('error', 'Error in parameter \"Averaging time\": scalar value expecte"
"d.'); return;\n"
"end\n"
                          MaskDialogCallback "Dialog:set('buffer_size', 'Visible', false)"
