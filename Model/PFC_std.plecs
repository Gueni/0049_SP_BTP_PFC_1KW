        Component {
          Type          Subsystem
          Name          "RMS Value2"
          Show          off
          Position      [1670, 665]
          Direction     up
          Flipped       off
          LabelPosition south
          Frame         [-15, -15; 15, 15]
          SampleTime    "-1"
          CodeGenDiscretizationMethod "2"
          CodeGenTarget "Generic"
          MaskType      "RMS Value"
          MaskDescription "Computes the root mean square value of a period"
"ic input signal. \n"
"\n"
"For a sample time of 0, a continuous time implementation is calculated. Other"
"wise, the input signal is sampled with the sample time specified. \n"
"\n"
"The initial condition describes the input signal before simulation start."
          MaskHelp      "qthelp:///rms.html"
          MaskDisplay   "Icon:text('RMS')"
          MaskDisplayLang "2"
          MaskIconFrame on
          MaskIconOpaque on
          MaskIconRotates off
          MaskInit      "if x0 < 0\n"
"\tplecs('error', 'The initial condition must be >=0.'); return;\n"
"end\n"
"if fs <=0\n"
"\tplecs('error', 'Fundamental Frequency must be >0.'); return;\n"
"elseif fs == inf\n"
"\tplecs('error', 'Fundamental Frequency must be finite.'); return;\n"
"end\n"
"\n"
"if ts <0\n"
"\tplecs('error', 'Sample time must be 0 (continuous) or a postive number (dis"
"crete).'); return;\n"
"elseif ts == inf\n"
"\tplecs('error', 'Sample time must be finite.'); return;\n"
"end\n"
"\n"
"currentCircuit = plecs('get', '', 'CurrentCircuit');\n"
"circuitModel = plecs('get', currentCircuit, 'CircuitModel');\n"
"%if strcmp(circuitModel, 'ContStateSpace'),\n"
"t_averaging = 1/fs;\n"
"if ts == 0,\n"
"\ttimeDomain = 1;\n"
"else\n"
"\ttimeDomain = 2;\n"
"\tns = t_averaging/ts;\n"
"\t% Test if fundamental frequency is higher than the sampling frequency\n"
"\tif ns < 1,\n"
"\t\tplecs('error', 'The reciprocal of the sampling time must be >= the fundam"
"ental frequency'); return;\n"
"\tend\n"
"\tns_round = round(t_averaging/ts);\n"
"\t% test if ns is far from an integer value\n"
"\tif mod(abs(ns - ns_round),1.0) > 1e-6,\n"
"\t\tplecs('error', 'The reciprocal of the sample time must be an integer mult"
"iple of the fundamental frequency'); return;\n"
"\telse\n"
"\t\tns = ns_round;\n"
"\tend\n"
"\tif strcmp(circuitModel, 'ContStateSpace'),\n"
"\t\tplecs('warning','Using a discrete sample time with a variable-step solver"
" may slow down your simulation. You should set the sample time to 0 to use th"
"e continuous implementation of the RMS block.')\n"
"\tend\n"
"end"
          Parameter {
            Variable      "x0"
            Prompt        "Initial condition"
            Type          FreeText
            Value         "0"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "ts"
            Prompt        "Sample time (s)"
            Type          FreeText
            Value         "1/(200*Grid.f)"
            Show          off
            Tunable       off
            TabName       ""
          }
          Parameter {
            Variable      "fs"
            Prompt        "Fundamental Frequency (Hz)"
            Type          FreeText
            Value         "Grid.f"
            Show          off
            Tunable       off
            TabName       ""
          }
          Terminal {
            Type          Input
            Position      [-15, 0]
            Direction     left
          }
