                Schematic {
                  Location      [255, 549; 536, 790]
                  ZoomFactor    1
                  SliderPosition [0, 0]
                  ShowBrowser   off
                  BrowserWidth  100
                  Component {
                    Type          Output
                    Name          "Out"
